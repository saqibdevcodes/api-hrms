generator client {
  provider = "prisma-client-js"

  engineType = "client"
}

datasource db {
  provider = "mysql"
}

// Authentication and User Management
model User {
  id    String @id @default(cuid())
  email String @unique

  // Name fields
  firstName String
  lastName  String

  // Family Details
  fatherHusbandName String?

  // CNIC Details
  cnic       String?   @unique
  cnicExpiry DateTime?

  // Personal Information
  maritalStatus MaritalStatus?
  dateOfBirth   DateTime?
  bloodGroup    BloodGroup?
  gender        Gender?

  // Education
  education          EducationLevel?
  educationInstitute String?
  educationGrade     String?

  // Contact Information
  personalEmail  String?
  personalMobile String?
  officialMobile String?
  officialEmail  String?
  phone          String? // Alternative phone

  // Address Information
  personalAddress String? @db.Text
  address         String? @db.Text // Work address
  city            String?
  state           String?
  zipCode         String?
  country         String  @default("Pakistan")

  // Employment Information
  employeeId       String? // IC-EMP001, IC-ADM001, etc.
  userRank         UserRank?
  password         String
  status           UserStatus @default(ACTIVE)
  role             Role       @default(EMPLOYEE)
  position         String?
  department       String? // Department name as text
  manager          String?
  salary           Decimal?
  currency         String     @default("PKR")
  dateOfJoining    DateTime?
  dateOfExit       DateTime?
  hireDate         DateTime? // Same as dateOfJoining, kept for compatibility
  endDate          DateTime? // Same as dateOfExit, kept for compatibility
  employmentTypeId String?

  // Document Pictures (stored as file paths)
  profilePicture   String?
  degreePicture    String?
  cnicPictureFront String?
  cnicPictureBack  String?

  // Insurance Policy fields
  hasInsurance                 Boolean?  @default(false)
  insuranceCardNo              String?
  insuranceInsuredName         String?
  insuranceEmployeeNo          String?
  insuranceValidUpto           DateTime?
  insuranceSpouseChildren      String?
  insuranceHospitalization     String?
  insuranceRoomLimit           String?
  insuranceNormalDelivery      String?
  insuranceComplicatedDelivery String?
  insuranceCardPicture         String?

  // System fields
  isActive  Boolean   @default(true)
  lastLogin DateTime?

  // Password Reset
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Foreign Key Relations
  emergencyDetailId String?
  departmentId      String?
  contractTypeId    String?
  designationId     String?
  shiftId           String?
  leaveId           String?

  // Relations
  emergencyDetail  EmergencyDetail? @relation(fields: [emergencyDetailId], references: [id])
  departmentEntity Department?      @relation(fields: [departmentId], references: [id])
  contractType     ContractType?    @relation(fields: [contractTypeId], references: [id])
  designation      Designation?     @relation(fields: [designationId], references: [id])
  shift            Shift?           @relation(fields: [shiftId], references: [id])
  leavePolicy      LeavePolicy?     @relation(fields: [leaveId], references: [id])
  employmentType   EmploymentType?  @relation(fields: [employmentTypeId], references: [id])

  // Employee-related relations (moved from Employee model)
  attendances          Attendance[]
  zktecoStagingRecords ZKTecoAttendanceStaging[] @relation("StagingAttendance")
  zktecoRecords        ZKTecoAttendanceRecord[]  @relation("FinalAttendance")
  leaveRequests        LeaveRequest[]
  payrollRecords       PayrollRecord[]
  performanceReviews   PerformanceReview[]
  notifications        Notification[]

  createdBy           String?
  updatedBy           String?
  EducationalDetail   EducationalDetail? @relation(fields: [educationalDetailId], references: [id])
  educationalDetailId Int?

  pdrs           Pdr[] @relation("PdrEmployee")
  pdrLineManager Pdr[] @relation("PdrLineManager")
  pdrDirector    Pdr[] @relation("PdrDirector")

  // Employee leave back-reference
  employeeLeave EmployeeLeave?
  Loan          Loan[]
  AdvanceSalary AdvanceSalary[]
  attendanceReasons AttendanceReason[] @relation("EmployeeAttendanceReasons")

  hasSystemAccess Boolean @default(true)

  eventAssigneeRecords       EventAssignee[]    @relation("EventAssigneeUser")
  requirementAssignedRecords EventRequirement[] @relation("RequirementAssignedEmployee")
  hostedEvents               Event[]            @relation("EventHostUser")

  companyMemberships CompanyEmployee[]

  requestedTickets      Ticket[]           @relation("TicketRequester")
  ticketAssignments     TicketAssignee[]   @relation("TicketAssignedUser")
  ticketAssignmentsMade TicketAssignee[]   @relation("TicketAssignedByUser")
  ticketComments        TicketComment[]    @relation("TicketCommentAuthor")
  ticketAttachments     TicketAttachment[] @relation("TicketAttachmentUploader")
  ticketWatchers        TicketWatcher[]
  ticketActivities      TicketActivity[]   @relation("TicketActivityActor")

  @@map("users")
}

// Emergency Contact Details
model EmergencyDetail {
  id             String   @id @default(cuid())
  contactName    String
  contactPhone   String
  contactEmail   String?
  relationship   String
  contactAddress String?
  alternatePhone String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  users User[]

  @@map("emergency_details")
}

// Contract Types
enum ContractDurationUnit {
  MONTH
  YEAR
}

model ContractType {
  id           String               @id @default(cuid())
  name         String               @unique
  description  String?              @db.Text
  duration     Int?
  durationUnit ContractDurationUnit @default(MONTH)
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  // Relations
  users              User[]
  companyAssignments CompanyContractType[]

  @@map("contract_types")
}

// Designations/Job Titles
model Designation {
  id          String   @id @default(cuid())
  title       String   @unique
  description String?  @db.Text
  level       Int? // Hierarchy level
  department  String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users User[]

  @@map("designations")
}

// Work Shifts
model Shift {
  id           String    @id @default(cuid())
  name         String    @unique
  startTime    DateTime
  endTime      DateTime
  breakTime    Int? // Break duration in minutes
  halfDayStart DateTime?
  fullDayStart DateTime?
  earlyOut     DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  users              User[]
  companyAssignments CompanyShift[]

  @@map("shifts")
}

model OffDay {
  id        String   @id @default(cuid())
  date      DateTime
  reason    String   @db.Text
  datetime  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("off_days")
}

// Leave Policies
model LeavePolicy {
  id           String   @id @default(cuid())
  name         String   @unique
  annualLeaves Int      @default(21)
  sickLeaves   Int      @default(10)
  casualLeaves Int      @default(5)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  users              User[]
  EmployeeLeave      EmployeeLeave[]
  companyAssignments CompanyLeavePolicy[]

  @@map("leave_policies")
}

model EmployeeLeave {
  id            Int          @id @default(autoincrement())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  annualLeaves  Int
  sickLeaves    Int
  casualLeaves  Int
  leavePolicyId String?
  leavePolicy   LeavePolicy? @relation(fields: [leavePolicyId], references: [id])
  datetime      DateTime

  @@map("employee_leaves")
}

//this is the users leaves table which is used to store the leaves of the users

// Employment Types
model EmploymentType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users              User[]
  companyAssignments CompanyEmploymentType[]

  @@map("employment_types")
}

model EducationalDetail {
  id       Int      @id @default(autoincrement())
  user     User[]
  userId   String
  name     String
  type     String
  picture  String?
  datetime DateTime

  @@map("educational_details")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  manager     String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users              User[]
  companyAssignments CompanyDepartment[]
  shiftTimings       DepartmentShiftTiming[]

  @@map("departments")
}

model Company {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  email       String?
  phone       String?
  website     String?
  address     String?  @db.Text
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees        CompanyEmployee[]
  departments      CompanyDepartment[]
  contractTypes    CompanyContractType[]
  shifts           CompanyShift[]
  leavePolicies    CompanyLeavePolicy[]
  employmentTypes  CompanyEmploymentType[]
  pdrs             Pdr[]
  ticketCategories TicketCategory[]
  tickets          Ticket[]

  @@index([isActive])
  @@map("companies")
}

model CompanyEmployee {
  companyId  String
  userId     String
  assignedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_employees")
}

model CompanyDepartment {
  companyId    String
  departmentId String
  assignedAt   DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([companyId, departmentId])
  @@index([departmentId])
  @@map("company_departments")
}

model CompanyContractType {
  companyId      String
  contractTypeId String
  assignedAt     DateTime @default(now())

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contractType ContractType @relation(fields: [contractTypeId], references: [id], onDelete: Cascade)

  @@id([companyId, contractTypeId])
  @@index([contractTypeId])
  @@map("company_contract_types")
}

model CompanyShift {
  companyId  String
  shiftId    String
  assignedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  shift   Shift   @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@id([companyId, shiftId])
  @@index([shiftId])
  @@map("company_shifts")
}

model CompanyLeavePolicy {
  companyId     String
  leavePolicyId String
  assignedAt    DateTime @default(now())

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

  @@id([companyId, leavePolicyId])
  @@index([leavePolicyId])
  @@map("company_leave_policies")
}

model CompanyEmploymentType {
  companyId        String
  employmentTypeId String
  assignedAt       DateTime @default(now())

  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employmentType EmploymentType @relation(fields: [employmentTypeId], references: [id], onDelete: Cascade)

  @@id([companyId, employmentTypeId])
  @@index([employmentTypeId])
  @@map("company_employment_types")
}

// Attendance Management
// Enhanced Attendance model to support ZKTeco device data
model Attendance {
  id       String           @id @default(cuid())
  date     DateTime         @db.Date // Date only (YYYY-MM-DD)
  checkIn  DateTime? // First check-in time of the day
  checkOut DateTime? // Last check-out time of the day
  status   AttendanceStatus @default(PRESENT)
  reason   String?          @db.Text
  notes    String?          @db.Text

  // ZKTeco device integration fields
  deviceCheckIns  Int       @default(0) // Count of check-ins from device
  deviceCheckOuts Int       @default(0) // Count of check-outs from device
  lastDeviceSync  DateTime? // Last time device data was synced

  // Working hours calculation
  totalHours    Decimal? @db.Decimal(5, 2) // Total working hours for the day
  overtimeHours Decimal? @db.Decimal(5, 2) // Overtime hours

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employee              User                 @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId            String
  AttendanceReason      AttendanceReason?    @relation(fields: [attendanceReasonId], references: [id])
  attendanceReasonId    String?
  AttendanceDeduction   AttendanceDeduction? @relation(fields: [attendanceDeductionId], references: [id])
  attendanceDeductionId String?

  // Relation to ZKTeco records
  zktecoRecords ZKTecoAttendanceRecord[]

  @@unique([employeeId, date])
  @@map("attendances")
}

// STAGING TABLE: Raw ZKTeco device records retained for audit/retry purposes.
// Valid punches are finalized into live attendance immediately.
model ZKTecoAttendanceStaging {
  id String @id @default(cuid())

  // ZKTeco device data
  employeeId String // User ID from ZKTeco device (e.g., "100074")
  deviceId   String // Device serial number (e.g., "AF4C211360469")
  timestamp  DateTime // Exact punch time from device
  checkType  ZKTecoCheckType // check_in or check_out
  verifyType Int // 1=Fingerprint, 2=Password, 3=Card, etc.
  workCode   String? // Work code from device (optional)

  // Calculated attendance status based on shift rules
  overallStatus AttendanceStatusType?

  // Processing status
  processed       Boolean @default(false) // Whether this record has been processed
  processingError String? @db.Text // Error message if processing failed

  // Finalization tracking
  isFinalized Boolean   @default(false) // Whether moved to final table
  finalizedAt DateTime? // When moved to final table
  finalizedBy String? // User ID who forced finalization (if manual)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  User   User?   @relation("StagingAttendance", fields: [userId], references: [id])
  userId String? // Link to actual user (after ID mapping)

  @@index([employeeId])
  @@index([deviceId])
  @@index([timestamp])
  @@index([isFinalized])
  @@index([createdAt])
  @@map("zkteco_attendance_staging")
}

// FINAL TABLE: Verified ZKTeco attendance records shown immediately to HR/Admin.
model ZKTecoAttendanceRecord {
  id String @id @default(cuid())

  // ZKTeco device data
  employeeId String // User ID from ZKTeco device (e.g., "100074")
  deviceId   String // Device serial number (e.g., "AF4C211360469")
  timestamp  DateTime // Exact punch time from device
  checkType  ZKTecoCheckType // check_in or check_out
  verifyType Int // 1=Fingerprint, 2=Password, 3=Card, etc.
  workCode   String? // Work code from device (optional)

  // Calculated attendance status based on shift rules
  overallStatus AttendanceStatusType?

  // Processing status
  processed       Boolean @default(false) // Whether this record has been processed into attendance
  processingError String? @db.Text // Error message if processing failed

  // Deduction tracking
  usedForDeduction   Boolean   @default(false) // Whether this record has been used for progressive deductions
  deductionAppliedAt DateTime? // When deduction was applied using this record

  // Finalization metadata
  finalizedFrom String? // Staging record ID this was created from
  finalizedAt   DateTime? // When moved from staging
  finalizedBy   String? // User ID who forced finalization (if manual)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  User         User?       @relation("FinalAttendance", fields: [userId], references: [id])
  userId       String? // Link to actual user (after ID mapping)
  attendance   Attendance? @relation(fields: [attendanceId], references: [id])
  attendanceId String? // Link to daily attendance record

  @@index([employeeId])
  @@index([deviceId])
  @@index([timestamp])
  @@index([processed])
  @@map("zkteco_attendance_records")
}

// Enum for ZKTeco check types
enum ZKTecoCheckType {
  check_in
  check_out
  break_out
  break_in
  overtime_in
  overtime_out
}

// Enum for detailed attendance status based on shift rules
enum AttendanceStatusType {
  ON_TIME_ARRIVAL
  LATE
  HALF_DAY_LEAVE // Based on time of arrival (toa >= hfs && < fds) && Based on time of leave (tol >= fds && < eo)
  FULL_DAY_LEAVE_POTENTIAL // Based on time of arrival (toa >= fds) - pending checkout validation
  FULL_DAY_LEAVE // Based on time of arrival (toa >= fds) && Based on time of leave (tol < fds && > st)
  EARLY_OUT
  ON_TIME_LEAVE
  ABSENT
}

model AttendanceReason {
  id                String       @id @default(cuid())
  attendanceId      String
  attendance        Attendance[]
  reason            String?      @db.Text
  reasonDetails     String?      @db.Text
  projectName       String?
  projectManager    String?
  projectDepartment String?
  taskAsignedBy     String?
  taskDetail        String?      @db.Text
  fieldAddress      String?      @db.Text
  reasonComment     String?      @db.Text
  status            String? //approved, rejected, pending
  datetime          DateTime

  // Regularisation workflow fields
  regularisationType String? // TECHNICAL_ISSUE, FIELD_WORK, BIOMETRIC_GLITCH, MISSING_PUNCH, OTHER
  employeeId         String?
  employee           User?   @relation("EmployeeAttendanceReasons", fields: [employeeId], references: [id])
  notifiedRecipients String? @db.Text
  reviewedBy         String?
  reviewedAt         DateTime?

  attachments AttendanceReasonAttachment[]

  @@index([employeeId])
  @@map("attendance_reasons")
}

model AttendanceReasonAttachment {
  id                 String           @id @default(cuid())
  attendanceReasonId String
  attendanceReason   AttendanceReason @relation(fields: [attendanceReasonId], references: [id])
  details            String
  image              String
  datetime           DateTime

  @@map("attendance_reason_attachments")
}

model AttendanceDeduction {
  id              String       @id @default(cuid())
  attendanceId    String
  attendance      Attendance[]
  deductionReason String       @db.Text
  deductValue     Float
  leaveId         Int?
  datetime        DateTime

  // Track which ZKTeco records triggered this deduction
  zktecoRecordIds String? @db.Text // JSON array of ZKTeco record IDs that triggered this deduction
  deductionType   String? // "LATE_TO_HALF_DAY" or "HALF_DAY_TO_FULL_DAY"

  @@map("attendance_deductions")
}

// Attendance Policy Rules & Global Portal Settings
model AttendancePolicySetting {
  id                                String   @id @default(cuid())
  policyName                        String   @default("Iris Communications Attendance Policy")
  scopeDescription                  String?  @db.Text

  // Grace Period: 15 minutes allowed after official reporting time
  gracePeriodMinutes                Int      @default(15)

  // Monthly Allowances & Thresholds
  monthlyLateArrivalsAllowed        Int      @default(3) // 3 late comings allowed per month
  lateArrivalThresholdMinutes       Int      @default(60) // up to 1 hour late
  monthlyEarlyOutAllowed            Int      @default(1) // 1 early out allowed per month
  earlyOutThresholdMinutes          Int      @default(60) // up to 1 hour early
  lateExceededDeduction             String   @default("HALF_DAY_LEAVE") // HALF_DAY_LEAVE or LEAVE_WITHOUT_PAY
  earlyOutExceededDeduction         String   @default("HALF_DAY_LEAVE") // HALF_DAY_LEAVE or LEAVE_WITHOUT_PAY

  // Missing Punch Rules
  missingBothPunchesAction          String   @default("ABSENT") // Missing both IN and OUT without justification counts as Absent
  missingOnePunchAction             String   @default("LATE_OR_EARLY") // Missing only one punch is treated as Late IN or Early OUT
  deductSalaryOnUnjustifiedAbsent   Boolean  @default(true) // Salary deduction on unjustified absent

  // Biometric Attendance Tracking Rules
  mandatoryBiometric                Boolean  @default(true) // Mandatory thumb impression or face scanning
  allowedBiometricMethods           String   @default("THUMB_FACE") // THUMB_FACE
  requireTimeInAndTimeOut           Boolean  @default(true)
  trackHeadAndRegionalOffices       Boolean  @default(true)

  // Technical Issue & Field Work Regularisation Workflow Rules
  regularisationDeadlineDays        Int      @default(1) // By next working day
  regularisationNotifyHR            Boolean  @default(true)
  regularisationNotifyIT            Boolean  @default(true)
  regularisationNotifyHOD           Boolean  @default(true)
  regularisationNotifyLineManager   Boolean  @default(true)
  hrEmails                          String   @default("hr@iriscommunications.com.pk")
  itEmails                          String   @default("it@iriscommunications.com.pk")
  allowTechnicalIssueRegularisation Boolean  @default(true)
  allowFieldWorkRegularisation      Boolean  @default(true)

  isActive                          Boolean  @default(true)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@map("attendance_policy_settings")
}

// Department-wise Working Shift Timings
model DepartmentShiftTiming {
  id             String      @id @default(cuid())
  name           String      // "General Departments", "Administrative Staff (Research Wing)", etc.
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  category       String      @default("GENERAL") // GENERAL, RESEARCH_WING, CUSTOM

  // Monday - Thursday
  monThuStart    String      @default("09:30")
  monThuEnd      String      @default("18:00")

  // Friday
  friStart       String      @default("09:30")
  friEnd         String      @default("18:00")

  // Saturday
  satStart       String      @default("09:30")
  satEnd         String      @default("18:00")
  satWorkingType String      @default("ALTERNATE") // ALTERNATE, ALL, OFF

  // Sunday
  sunWorkingType String      @default("OFF") // OFF, WORKING

  notes          String?     @db.Text
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@map("department_shift_timings")
}

// Leave Management
model LeaveRequest {
  id                    String        @id @default(cuid())
  leaveType             LeaveType
  startDate             DateTime
  endDate               DateTime
  days                  Int
  reason                String        @db.Text
  status                RequestStatus @default(PENDING)
  comments              String?       @db.Text
  approvedByLineManager String?
  approvedByHr          String?
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // Relations
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@map("leave_requests")
}

// Payroll Management
model PayrollRecord {
  id          String        @id @default(cuid())
  payPeriod   String // "January 2024", "Q1 2024", etc.
  basicSalary Decimal
  overtime    Decimal       @default(0)
  bonus       Decimal       @default(0)
  deductions  Decimal       @default(0)
  netPay      Decimal
  status      PayrollStatus @default(PENDING)
  payDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@map("payroll_records")
}

// Performance Management
model PerformanceReview {
  id            String       @id @default(cuid())
  reviewPeriod  String // "Q4 2023", "2023 Annual", etc.
  rating        Int // 1-5 scale
  goalsMet      Int          @default(0)
  totalGoals    Int          @default(0)
  manager       String
  feedback      String?      @db.Text
  status        ReviewStatus @default(DRAFT)
  dateCreated   DateTime     @default(now())
  dateCompleted DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Relations
  employee   User   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId String

  @@map("performance_reviews")
}

// Notification Management
model Notification {
  id         String               @id @default(cuid())
  title      String
  message    String               @db.Text
  type       NotificationType
  priority   NotificationPriority @default(MEDIUM)
  isRead     Boolean              @default(false)
  data       Json? // Additional data for the notification
  createdAt  DateTime             @default(now())
  readAt     DateTime?
  fromUserId String? // Track who created/sent the notification

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@map("notifications")
}

// Helpdesk Ticket Management
model TicketCategory {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String
  description          String?  @db.Text
  color                String   @default("blue")
  icon                 String   @default("life-buoy")
  supportEmail         String?
  routingDepartment    String?
  firstResponseMinutes Int      @default(240)
  resolutionMinutes    Int      @default(2880)
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company   Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String?
  tickets   Ticket[]

  @@unique([companyId, slug])
  @@index([isActive, sortOrder])
  @@map("ticket_categories")
}

model TicketSequence {
  period      String
  serviceCode String
  lastNumber  Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([period, serviceCode])
  @@map("ticket_sequences")
}

model Ticket {
  id                  String         @id @default(cuid())
  ticketNumber        String         @unique
  subject             String
  description         String         @db.Text
  status              TicketStatus   @default(OPEN)
  priority            TicketPriority @default(MEDIUM)
  impact              TicketImpact   @default(SINGLE_USER)
  channel             TicketChannel  @default(PORTAL)
  customCategory      String?
  contactPreference   String?        @default("PORTAL_EMAIL")
  firstResponseAt     DateTime?
  responseDueAt       DateTime?
  resolutionDueAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?
  reopenedAt          DateTime?
  lastActivityAt      DateTime       @default(now())
  resolutionSummary   String?        @db.Text
  rootCause           String?        @db.Text
  satisfactionRating  Int?
  satisfactionComment String?        @db.Text
  isEscalated         Boolean        @default(false)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  requester   User            @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  requesterId String
  category    TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId  String?
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId   String?

  comments    TicketComment[]
  attachments TicketAttachment[]
  assignees   TicketAssignee[]
  watchers    TicketWatcher[]
  activities  TicketActivity[]

  @@index([requesterId, createdAt])
  @@index([companyId, status, priority])
  @@index([categoryId, status])
  @@index([resolutionDueAt, status])
  @@index([lastActivityAt])
  @@map("tickets")
}

model TicketComment {
  id         String   @id @default(cuid())
  body       String   @db.Text
  isInternal Boolean  @default(false)
  isEdited   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId    String
  author      User               @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorId    String
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@map("ticket_comments")
}

model TicketAttachment {
  id         String   @id @default(cuid())
  fileName   String
  fileUrl    String
  mimeType   String
  fileSize   Int
  storageKey String?
  createdAt  DateTime @default(now())

  ticket       Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId     String
  comment      TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId    String?
  uploadedBy   User           @relation("TicketAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedById String

  @@index([ticketId])
  @@index([commentId])
  @@map("ticket_attachments")
}

model TicketWatcher {
  ticketId String
  userId   String
  addedAt  DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
  @@map("ticket_watchers")
}

model TicketAssignee {
  ticketId     String
  userId       String
  assignedById String?
  assignedAt   DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user       User   @relation("TicketAssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User?  @relation("TicketAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([ticketId, userId])
  @@index([userId, assignedAt])
  @@index([assignedById])
  @@map("ticket_assignees")
}

model TicketActivity {
  id        String   @id @default(cuid())
  action    String
  field     String?
  oldValue  String?  @db.Text
  newValue  String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  ticket   Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId String
  actor    User?   @relation("TicketActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId  String?

  @@index([ticketId, createdAt])
  @@map("ticket_activities")
}

model Loan {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal
  interest     Decimal?
  totalAmount  Decimal?
  installments Int?
  tenure       Int? // in months
  reason       String?   @db.Text
  startDate    DateTime?
  endDate      DateTime?
  status       String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("loans")
}

model AdvanceSalary {
  id         String   @id @default(cuid())
  userId     String
  daysCount  Int
  reason     String   @db.Text
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Status     String?
  ApprovedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

