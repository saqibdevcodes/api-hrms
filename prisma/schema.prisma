// PDR Status Enums

// Individual role status (for emp_status, linemanager_status, etc.)
enum PdrStatus {
  PENDING // Not started yet
  IN_PROGRESS // Currently filling
  SUBMITTED // Submitted to next party
  APPROVED // Approved by reviewer
  REVERTED // Sent back for rework
  ACKNOWLEDGED // Acknowledged (employee only)
  COMPLETED // Final completion
}

// Overall PDR lifecycle status (19-step flow)
enum PdrOverallStatus {
  // 1. Creation
  CREATED_BY_HR // 1: HR creates PDR

  // 2-5. Employee Fill & Submit (with potential HR loop)
  EMPLOYEE_FILLING // 2: Employee is filling
  EMPLOYEE_PENDING
  EMPLOYEE_SUBMITTED_TO_HR // 3: Employee submitted to HR for review
  HR_REVIEWING_EMPLOYEE // 4: HR reviewing employee's part
  HR_REVERTED_TO_EMPLOYEE // 5: HR sent back to employee (loops back to 2)
  HR_APPROVED_EMPLOYEE // 6: HR approved employee's part

  // 7-11. Manager Fill & Submit (with potential HR loop)
  MANAGER_FILLING // 7: Manager is filling
  MANAGER_PENDING
  MANAGER_SUBMITTED_TO_HR // 8: Manager submitted to HR
  HR_REVIEWING_MANAGER // 9: HR reviewing manager's part
  HR_REVERTED_TO_MANAGER // 10: HR sent back to manager (loops back to 7)
  HR_APPROVED_MANAGER // 11: HR approved manager's part

  // 12-15. Employee Acknowledgment (with potential revert loop)
  EMPLOYEE_ACKNOWLEDGING // 12: Employee reviewing for acknowledgment
  EMPLOYEE_DISAGREED // 13: Employee disagreed with manager assessment
  EMPLOYEE_REVERT_TO_MANAGER // 14: Employee requested changes from manager
  MANAGER_REVISING // 15: Manager revising (loops back)
  EMPLOYEE_ACKNOWLEDGED // 16: Employee acknowledged

  // 17-19. Director Review & Completion
  DIRECTOR_REVIEWING // 17: Director reviewing final PDR
  DIRECTOR_REVIEWED // 18: Director completed review
  COMPLETED // 19: PDR fully completed and locked
}

//PDR Management

model Pdr {
  id            Int       @id @default(autoincrement())
  user          User      @relation("PdrEmployee", fields: [userId], references: [id])
  userId        String
  creation_date DateTime  @default(now())
  pdr_cycle     String?   @db.VarChar(50) // "Q1 2024", "2024 Annual", etc.
  pdrCycle      PdrCycle? @relation(fields: [pdrCycleId], references: [id])
  pdrCycleId    Int?
  pdr_timeline  String?
  company       Company   @relation(fields: [companyId], references: [id])
  companyId     String    @default("company_iriscommunications")

  // Relations to other users
  linemanager    User?   @relation("PdrLineManager", fields: [linemanager_id], references: [id])
  linemanager_id String?
  director       User?   @relation("PdrDirector", fields: [director_id], references: [id])
  director_id    String?

  // Overall PDR Status (follows 19-step flow)
  overallStatus PdrOverallStatus @default(CREATED_BY_HR)

  // Individual role statuses (for granular tracking)
  emp_status         PdrStatus @default(PENDING)
  linemanager_status PdrStatus @default(PENDING)
  director_status    PdrStatus @default(PENDING)
  hr_status          PdrStatus @default(PENDING)

  // Tracking fields
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  lastModifiedBy String? // User ID who last modified
  lastModifiedAt DateTime  @default(now()) @updatedAt

  // HR can close employee portal access immediately or at a scheduled time.
  // A future value is also used by the employee UI as a live countdown.
  employeePortalClosesAt DateTime?
  employeePortalClosedBy String?

  // Manager recommendations (visible to HR and Manager only, NOT to employee)
  training_required     Boolean? @default(false)
  training_description  String?  @db.Text
  promotion_recommended Boolean? @default(false)
  promotion_description String?  @db.Text

  // Director's overall PDR comment
  director_overall_comment String? @db.Text

  // Phase restrictions. Null deadline or noRestriction=true means unrestricted.
  employeeAccessDeadline               DateTime?
  employeeAccessNoRestriction          Boolean   @default(true)
  hrEmployeeApprovalDeadline           DateTime?
  hrEmployeeApprovalNoRestriction      Boolean   @default(true)
  managerAccessDeadline                DateTime?
  managerAccessNoRestriction           Boolean   @default(true)
  hrManagerApprovalDeadline            DateTime?
  hrManagerApprovalNoRestriction       Boolean   @default(true)
  directorReviewDeadline               DateTime?
  directorReviewNoRestriction          Boolean   @default(true)
  employeeAcknowledgementDeadline      DateTime?
  employeeAcknowledgementNoRestriction Boolean   @default(true)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  // Relations to PDR components
  comments          PdrComment[]
  personalQualities PdrPersonalQuality[]
  goalsTasks        PdrGoalsTask[]
  overallComments   PdrOverallComment[]
  transitions       PdrStatusTransition[]

  @@unique([userId, pdr_cycle, companyId]) // One PDR per employee, cycle, and company
  @@index([companyId])
  @@index([employeePortalClosesAt])
  @@map("pdr")
}

model PdrCycle {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  description String?   @db.Text
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(true)
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  pdrs Pdr[]

  @@map("pdr_cycles")
}

// Track status transitions for audit trail
model PdrStatusTransition {
  id            Int              @id @default(autoincrement())
  pdr           Pdr              @relation(fields: [pdrId], references: [id], onDelete: Cascade)
  pdrId         Int
  fromStatus    PdrOverallStatus
  toStatus      PdrOverallStatus
  changedBy     String // User ID
  changedByRole String // "EMPLOYEE", "LINE_MANAGER", "HR", "DIRECTOR"
  comment       String?          @db.Text
  createdAt     DateTime         @default(now())

  @@map("pdr_status_transitions")
}

model PdrComment {
  id              Int      @id @default(autoincrement())
  pdr             Pdr      @relation(fields: [pdr_id], references: [id], onDelete: Cascade)
  pdr_id          Int
  employee_type   String // "EMPLOYEE", "LINE_MANAGER", "HR", "DIRECTOR"
  pdr_status_type String // Status when comment was made
  description     String   @db.Text
  datetime        DateTime @default(now())

  // Extended fields for revert messages
  commentType String?   @default("GENERAL") // "GENERAL", "REVERT", "APPROVAL", "FEEDBACK"
  sentTo      String? // Who this message is for (for REVERT type)
  isResolved  Boolean   @default(false) // For REVERT messages
  resolvedAt  DateTime?

  @@map("pdr_comments")
}

model PdrPersonalQuality {
  id                        Int      @id @default(autoincrement())
  pdr                       Pdr      @relation(fields: [pdr_id], references: [id], onDelete: Cascade)
  pdr_id                    Int
  employee_type             String
  communication             Int
  innovation                Int
  work_ethics               Int
  teamwork                  Int
  maturity                  Int
  initiative                Int
  self_management           Int
  customer_focus            Int
  sense_of_responsibilities Int
  accountability            Int
  work_knowledge            Int
  attendance                Int
  leadership                Int
  comment                   String   @db.Text
  datetime                  DateTime

  @@map("pdrpersonalquality")
}

model PdrGoalsTask {
  id                   Int      @id @default(autoincrement())
  pdr                  Pdr      @relation(fields: [pdr_id], references: [id], onDelete: Cascade)
  pdr_id               Int
  task                 String   @db.Text
  employee_self_rating Int
  linemanager_rating   Int
  datetime             DateTime

  @@map("pdrgoalstask")
}

model PdrOverallComment {
  id            Int      @id @default(autoincrement())
  pdr           Pdr      @relation(fields: [pdr_id], references: [id], onDelete: Cascade)
  pdr_id        Int
  employee_type String
  comment       String   @db.Text
  datetime      DateTime

  @@map("pdroverallcomment")
}

model Document {
  id          Int      @id @default(autoincrement())
  name        String
  description String   @db.Text
  file        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EmailJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model EmailJob {
  id          String         @id @default(cuid())
  event       String
  payload     Json
  status      EmailJobStatus @default(PENDING)
  attempts    Int            @default(0)
  maxAttempts Int            @default(3)
  lastError   String?        @db.Text
  scheduledAt DateTime       @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status, scheduledAt])
  @@map("email_jobs")
}

// Event Management Enums & Models

enum EventPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EventMode {
  OFFLINE
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PENDING_APPROVAL
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Master Table: Predefined Event Types (SUPERADMIN)
model EventTypeMaster {
  id          String   @id @default(cuid())
  name        String   @unique @db.VarChar(191)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventEventType[]

  @@map("event_types_master")
}

// Master Table: Predefined Venues (SUPERADMIN)
model VenueMaster {
  id            String   @id @default(cuid())
  name          String   @unique @db.VarChar(191)
  address       String?  @db.Text
  capacity      Int?
  contactPerson String?
  contactNumber String?
  notes         String?  @db.Text
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events Event[]

  @@map("venues_master")
}

// Master Table: Hierarchical Requirements (SUPERADMIN)
model RequirementMaster {
  id          String   @id @default(cuid())
  parentId    String?
  name        String
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   RequirementMaster?  @relation("RequirementHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children RequirementMaster[] @relation("RequirementHierarchy")

  eventRequirements EventRequirement[]

  @@map("requirements_master")
}

// Core Event Model
model Event {
  id           String        @id @default(cuid())
  title        String
  description  String?       @db.Text
  eventDate    DateTime      @db.Date
  eventEndDate DateTime?     @db.Date
  startTime    DateTime
  endTime      DateTime?
  priority     EventPriority @default(NORMAL)
  mode         EventMode     @default(OFFLINE)
  status       EventStatus   @default(SCHEDULED)

  cancellationReason String? @db.Text

  // Online / Hybrid Meeting Info
  onlinePlatform String? // Zoom, Google Meet, Microsoft Teams, Other
  meetingLink    String? @db.Text
  meetingId      String?
  onlineNotes    String? @db.Text

  // Venue
  venueId            String?
  venue              VenueMaster? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  customVenueName    String?
  customVenueAddress String?      @db.Text

  // Custom Event Type
  customEventType String?

  // Outsourcing
  isOutsourced           Boolean  @default(false)
  outsourcingDescription String?  @db.Text
  vendorName             String?
  vendorContactPerson    String?
  vendorContactNumber    String?
  vendorEmail            String?
  estimatedCost          Decimal? @db.Decimal(10, 2)
  outsourcingNotes       String?  @db.Text

  // Event Host
  eventHostId         String?
  eventHostUser       User?   @relation("EventHostUser", fields: [eventHostId], references: [id], onDelete: SetNull)
  customEventHostName String?

  // Internal Notes & Audit
  internalNotes String? @db.Text
  createdById   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  eventTypes   EventEventType[]
  requirements EventRequirement[]
  assignees    EventAssignee[]
  checklists   EventChecklist[]
  attachments  EventAttachment[]
  activityLogs EventActivityLog[]

  @@map("events")
}

// Many-to-many join table for Event -> EventTypeMaster
model EventEventType {
  id          String          @id @default(cuid())
  eventId     String          @db.VarChar(191)
  event       Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTypeId String          @db.VarChar(191)
  eventType   EventTypeMaster @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)

  @@unique([eventId, eventTypeId])
  @@map("event_event_types")
}

// Event Requirement Selections
model EventRequirement {
  id                String             @id @default(cuid())
  eventId           String
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  requirementId     String?
  requirement       RequirementMaster? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  customRequirement String?
  quantity          Int?
  unit              String?
  notes             String?            @db.Text

  // Department & Assigned Responsible Employee for this Requirement
  departmentName     String?
  assignedEmployeeId String?
  assignedEmployee   User?   @relation("RequirementAssignedEmployee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@map("event_requirements")
}

// Event Team / Assignees
model EventAssignee {
  id                 String  @id @default(cuid())
  eventId            String
  event              Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  employeeId         String?
  employee           User?   @relation("EventAssigneeUser", fields: [employeeId], references: [id], onDelete: SetNull)
  externalName       String?
  responsibilityType String // Event Manager, Responsible Person, Management, Coordinator, Support Staff, Technical Support, Other
  notes              String? @db.Text

  acknowledgementStatus String    @default("PENDING") // PENDING, ACCEPTED, DECLINED
  acknowledgedAt        DateTime?

  @@map("event_assignees")
}

// Event Checklists
model EventChecklist {
  id            String    @id @default(cuid())
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title         String
  completed     Boolean   @default(false)
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("event_checklists")
}

// Event Attachments
model EventAttachment {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name         String
  fileUrl      String   @db.Text
  fileSize     Int?
  fileType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@map("event_attachments")
}

// Event Activity Log
model EventActivityLog {
  id            String   @id @default(cuid())
  eventId       String
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  action        String // CREATED, UPDATED, STATUS_CHANGED, CANCELLED, REQUIREMENT_ADDED, ASSIGNEE_ADDED, etc.
  description   String   @db.Text
  performedById String?
  createdAt     DateTime @default(now())

  @@map("event_activity_logs")
}
